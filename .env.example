# ---------------------------------------------------------------------------
# Mealyn configuration. Copy to `.env` and fill in.
#
# Leave a block blank to run that rail in STUB mode (realistic fake behaviour).
# The whole agent loop works with everything blank except ANTHROPIC_API_KEY,
# which is what makes the planning / understanding actually intelligent.
# ---------------------------------------------------------------------------

MEALYN_ENV=development
MEALYN_TIMEZONE=Asia/Kolkata

# Claude (the Mealyn "Evon" reasoning brain). Without it, brain runs in stub mode.
ANTHROPIC_API_KEY=
MEALYN_MODEL=claude-opus-5-5

# WhatsApp Cloud API (Meta). Without a token, outbound messages are logged, not sent.
MEALYN_WHATSAPP__TOKEN=
MEALYN_WHATSAPP__PHONE_NUMBER_ID=
MEALYN_WHATSAPP__VERIFY_TOKEN=mealyn-verify
MEALYN_WHATSAPP__API_BASE=https://graph.facebook.com/v19.0

# Gnani voice rails. Without keys, STT returns a passthrough and TTS returns text.
MEALYN_GNANI__API_KEY=
MEALYN_GNANI__PRISMA_URL=
MEALYN_GNANI__TIMBRE_URL=

# UPI collect (Paytm / GPay / PhonePe). Without creds, a fake deeplink is returned.
MEALYN_PAYMENT__PROVIDER=paytm
MEALYN_PAYMENT__MERCHANT_ID=
MEALYN_PAYMENT__API_KEY=
